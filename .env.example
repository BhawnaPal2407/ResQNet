# ── ResQNet Application Environment Variables Template ────────────────────────

# Server Configuration
PORT=8080

# JWT Security Configuration
# Generate a strong key for production (at least 256-bits / 32 characters base64)
JWT_SECRET=UmVzUU5ldFN1cGVyU2VjcmV0S2V5Rm9ySldUQXV0aGVudGljYXRpb24yMDI1
JWT_EXPIRATION_MS=86400000

# Default Initial Admin Credentials
ADMIN_INITIAL_EMAIL=admin@resqnet.com
ADMIN_INITIAL_PASSWORD=Admin@123

# CORS Configuration
# Set comma-separated list of origins in production e.g., https://resqnet.app,https://admin.resqnet.app
CORS_ALLOWED_ORIGINS=*

# ── Database Configuration Options ──────────────────────────────────────────

# Option A: Default In-Memory H2 (Zero config for testing / light local run)
# SPRING_DATASOURCE_URL=jdbc:h2:mem:resqdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect

# Option B: PostgreSQL (Production default - Render / Supabase / Neon / Docker Compose)
POSTGRES_DB=resqdb
POSTGRES_USER=resquser
POSTGRES_PASSWORD=resqpassword
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resqdb
SPRING_DATASOURCE_USERNAME=resquser
SPRING_DATASOURCE_PASSWORD=resqpassword
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Hibernate DDL Mode (update / validate / none)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
